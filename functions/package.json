{
    "name": "ulsancl-functions",
    "version": "1.0.0",
    "description": "Ulsancl Stock Game - Cloud Functions for server-side verification",
    "main": "lib/index.js",
    "scripts": {
        "lint": "tsc --noEmit",
        "build": "npm run copy-engine && tsc",
        "build:watch": "tsc --watch",
        "copy-engine": "node ../scripts/copy-engine.cjs",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "dependencies": {
        "firebase-admin": "^14.5.0",
        "firebase-functions": "^7.4.0"
    },
    "overrides": {
        "gaxios": {
            "uuid": "11.1.1"
        }
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "eslint": "^8.57.1",
        "typescript": "^5.3.0"
    },
    "private": true
}
